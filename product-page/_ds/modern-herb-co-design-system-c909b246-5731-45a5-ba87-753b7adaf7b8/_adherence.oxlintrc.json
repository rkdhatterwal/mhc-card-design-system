{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/navigation/**",
              "components/product/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<BottomNavBar> doesn't accept that prop. Declared props: current, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavBar'] > JSXAttribute[name.name='current'] > Literal[value!=/^(?:shop|discover|account|cart)$/]",
        "message": "<BottomNavBar> current must be one of 'shop' | 'discover' | 'account' | 'cart'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconSize|added|disabled|full|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconSize, added, disabled, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cta|dark|outline)$/]",
        "message": "<Button> variant must be one of 'cta' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|pad|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, size, pad, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tile|promo|effect|count)$/]",
        "message": "<Chip> tone must be one of 'tile' | 'promo' | 'effect' | 'count'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EffectCountRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:strains|counts|key|ref|className|style|children)$/]",
        "message": "<EffectCountRow> doesn't accept that prop. Declared props: strains, counts."
      },
      {
        "selector": "JSXOpeningElement[name.name='EffectIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:strain|size|style|key|ref|className|style|children)$/]",
        "message": "<EffectIcon> doesn't accept that prop. Declared props: strain, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|fill|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, fill, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|shape|label|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, size, shape, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:bare|circle)$/]",
        "message": "<IconButton> shape must be one of 'bare' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|label|maxWidth|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, onClose, label, maxWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|strain|selected|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<OptionTile> doesn't accept that prop. Declared props: label, strain, selected, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PerksBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<PerksBar> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Product'] > JSXAttribute > JSXIdentifier[name!=/^(?:img|title|sub|brand|potencyWord|promo|strains|counts|options|ratingAvg|ratingCount|shipNote|key|ref|className|style|children)$/]",
        "message": "<Product> doesn't accept that prop. Declared props: img, title, sub, brand, potencyWord, promo, strains, counts, options, ratingAvg, ratingCount, shipNote."
      },
      {
        "selector": "JSXOpeningElement[name.name='PurchaseOptions'] > JSXAttribute > JSXIdentifier[name!=/^(?:oncePrice|subPrice|value|onChange|note|key|ref|className|style|children)$/]",
        "message": "<PurchaseOptions> doesn't accept that prop. Declared props: oncePrice, subPrice, value, onChange, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='PurchaseOptions'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:once|sub)$/]",
        "message": "<PurchaseOptions> value must be one of 'once' | 'sub'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuantityStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|width|style|key|ref|className|style|children)$/]",
        "message": "<QuantityStepper> doesn't accept that prop. Declared props: value, onChange, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rating'] > JSXAttribute > JSXIdentifier[name!=/^(?:average|count|size|style|key|ref|className|style|children)$/]",
        "message": "<Rating> doesn't accept that prop. Declared props: average, count, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:copyright|links|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: copyright, links, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<SizeButton> doesn't accept that prop. Declared props: selected, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopAppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|cartCount|wide|onMenu|onCart|style|key|ref|className|style|children)$/]",
        "message": "<TopAppBar> doesn't accept that prop. Declared props: brand, links, cartCount, wide, onMenu, onCart, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='VariantOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|strain|soldOut|key|ref|className|style|children)$/]",
        "message": "<VariantOption> doesn't accept that prop. Declared props: title, price, strain, soldOut."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
